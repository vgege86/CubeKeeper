<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>cubekeeper-web</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <!-- QR del segundo factor: C# puro, sin dependencias nativas (lo mismo que usa Home365). -->
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CubeKeeper.Core\CubeKeeper.Core.csproj" />
    <ProjectReference Include="..\CubeKeeper.Infrastructure\CubeKeeper.Infrastructure.csproj" />
  </ItemGroup>
</Project>
