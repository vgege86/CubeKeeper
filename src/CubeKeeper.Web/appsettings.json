{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CubeKeeper": {
    "DataPath": "/data",
    "Bds": {
      "Channel": "Stable",
      "AcceptEula": false,
      "AutoStart": true,
      "StopTimeoutSeconds": 30,
      "MaxRestarts": 3,
      "RestartWindowMinutes": 10
    },
    "Admin": {
      "UserName": "admin"
    }
  }
}
