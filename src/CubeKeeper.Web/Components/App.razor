<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    @* Se puede «añadir a la pantalla de inicio» y abrir como una app (sin la barra del navegador). *@
    <link rel="manifest" href="manifest.webmanifest" />
    <meta name="theme-color" content="#4f7f35" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1e17" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="CubeKeeper" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["CubeKeeper.Web.styles.css"]" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%235a8f3c'/%3E%3Crect x='4' y='4' width='8' height='8' fill='%23b5793e'/%3E%3C/svg%3E" />
    @* Sin <ImportMap />: es un script en línea (lo bloquearía la política de contenido) y en Blazor Server no hace falta. *@
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/menu.js"]"></script>
</body>

</html>
