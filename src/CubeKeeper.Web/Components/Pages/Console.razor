@page "/consola"
@rendermode InteractiveServer
@inherits AuditedPage
@implements IAsyncDisposable
@inject IServerController Server
@inject IConsoleLog Log
@inject IJSRuntime JS

<PageTitle>Consola · CubeKeeper</PageTitle>

<div class="console-header">
    <h1>Consola</h1>
    <span class="badge badge-@(_snap.Status == ServerStatus.Running ? "ok" : "idle")">@_snap.Status.ToSpanish()</span>
    <label class="check follow">
        <input type="checkbox" @bind="_follow" /> Seguir el final
    </label>
</div>

<div class="console" @ref="_consoleEl" role="log" aria-live="polite">
    @foreach (var line in _lines)
    {
        var (level, text) = Display(line);
        <div class="line line-@line.Kind.ToString().ToLowerInvariant() @(level is "WARN" or "ERROR" ? "lvl-" + level.ToLowerInvariant() : "")"><span class="ts">@line.Timestamp.ToString("HH:mm:ss")</span>@if (level is not null && level != "INFO") {<span class="lvl">@level</span>}<span class="msg">@(line.Kind == ConsoleLineKind.Command ? "> " : "")@text</span></div>
    }
</div>

<form class="command-bar" @onsubmit="SendAsync" @onsubmit:preventDefault>
    <input @bind="_command" @bind:event="oninput" placeholder="Comando (sin /), por ejemplo: list, say Hola, time set day"
           disabled="@(!IsAlive)" autocomplete="off" spellcheck="false" aria-label="Comando" />
    <button type="submit" class="btn btn-primary" disabled="@(!IsAlive || string.IsNullOrWhiteSpace(_command))">Enviar</button>
</form>
<div class="quick">
    <button class="btn btn-ghost" disabled="@(!IsAlive)" @onclick='() => QuickAsync("list")'>list</button>
    <button class="btn btn-ghost" disabled="@(!IsAlive)" @onclick='() => QuickAsync("save query")'>save query</button>
</div>
@if (_error is not null)
{
    <p class="alert alert-error">@_error</p>
}

@code {
    private const int MaxLines = 1000;
    private readonly List<ConsoleLine> _lines = [];
    private readonly Lock _gate = new();
    private ElementReference _consoleEl;
    private ServerSnapshot _snap = default!;
    private string _command = string.Empty;
    private string? _error;
    private bool _follow = true;
    private bool _renderPending;
    private IJSObjectReference? _module;

    private bool IsAlive => _snap.Status.IsProcessAlive();

    protected override void OnInitialized()
    {
        _snap = Server.Snapshot;
        var snapshot = Log.Snapshot();
        _lines.AddRange(snapshot.Skip(Math.Max(0, snapshot.Count - MaxLines)));
        Log.LineAdded += OnLine;
        Server.StateChanged += OnState;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/console.js");
        }
        if (_follow && _module is not null)
        {
            await _module.InvokeVoidAsync("scrollToEnd", _consoleEl);
        }
    }

    private void OnLine(ConsoleLine line)
    {
        lock (_gate)
        {
            _lines.Add(line);
            if (_lines.Count > MaxLines)
            {
                _lines.RemoveRange(0, _lines.Count - MaxLines);
            }
            if (_renderPending)
            {
                return;
            }
            _renderPending = true;
        }
        // Agrupar ráfagas de líneas (el arranque de BDS escribe muchas seguidas).
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(150);
            lock (_gate)
            {
                _renderPending = false;
            }
            StateHasChanged();
        });
    }

    private void OnState(ServerSnapshot snap)
    {
        _snap = snap;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task SendAsync()
    {
        var cmd = _command.Trim().TrimStart('/');
        if (cmd.Length == 0)
        {
            return;
        }
        await QuickAsync(cmd);
        if (_error is null)
        {
            _command = string.Empty;
        }
    }

    private async Task QuickAsync(string cmd)
    {
        _error = null;
        try
        {
            await Server.SendCommandAsync(cmd);
            await AuditAsync("console.command", null, cmd);
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException or IOException)
        {
            _error = ex.Message;
        }
    }

    /// <summary>Quita el prefijo "[fecha hora NIVEL]" de BDS: ya mostramos la hora y, si no es INFO, el nivel.</summary>
    private static (string? Level, string Text) Display(ConsoleLine line)
    {
        if (line.Kind != ConsoleLineKind.Output)
        {
            return (null, line.Text);
        }
        var parsed = CubeKeeper.Core.Logs.BdsLogLine.Parse(line.Text);
        return (parsed.Level, parsed.Message);
    }

    public async ValueTask DisposeAsync()
    {
        Log.LineAdded -= OnLine;
        Server.StateChanged -= OnState;
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
