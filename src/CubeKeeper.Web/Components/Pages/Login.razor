@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using CubeKeeper.Infrastructure.Persistence
@using Microsoft.AspNetCore.Identity
@inject SignInManager<PanelUser> SignInManager
@inject UserManager<PanelUser> UserManager
@inject NavigationManager Navigation
@inject CubeKeeper.Web.Hosting.AdminSeedStatus SeedStatus
@inject CubeKeeper.Infrastructure.Audit.AuditLog Audit
@inject CubeKeeper.Web.Hosting.ConnectionInfoService Connection

<PageTitle>Entrar · CubeKeeper</PageTitle>

<div class="card login-card">
    <div class="login-title">
        <span class="brand-cube big" aria-hidden="true"></span>
        <h1>CubeKeeper</h1>
    </div>

    @if (SeedStatus.Problem is not null)
    {
        <p class="alert alert-warn">
            @SeedStatus.Problem
            @if (_noUsers)
            {
                <br /><span>Corrígelo en la configuración de la app en TrueNAS y reiníciala.</span>
            }
        </p>
    }
    else if (_noUsers)
    {
        <p class="alert alert-warn">
            Todavía no hay ningún usuario. Define <code>CUBEKEEPER_ADMIN_PASSWORD</code> (10 caracteres o más)
            en la app de TrueNAS y reiníciala para crear el administrador.
        </p>
    }
    else if (SeedStatus.WasReset)
    {
        <p class="alert alert-ok">
            Contraseña restablecida. Cuando entres, quita <code>CUBEKEEPER_ADMIN_RESET</code> y
            <code>CUBEKEEPER_ADMIN_PASSWORD</code> de la app.
        </p>
    }

    @if (_error is not null)
    {
        <p class="alert alert-error" role="alert">@_error</p>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="LoginAsync" FormName="login">
        <DataAnnotationsValidator />
        <label>
            Usuario
            <InputText @bind-Value="Input!.UserName" autocomplete="username" autofocus />
        </label>
        <ValidationMessage For="() => Input!.UserName" />
        <label>
            Contraseña
            <InputText type="password" @bind-Value="Input!.Password" autocomplete="current-password" />
        </label>
        <ValidationMessage For="() => Input!.Password" />
        <label class="check">
            <InputCheckbox @bind-Value="Input!.RememberMe" /> Recordarme en este equipo
        </label>
        <button type="submit" class="btn btn-primary wide">Entrar</button>
    </EditForm>

    @if (_connection is not null)
    {
        <div class="join-box">
            <h2>¿Quieres jugar?</h2>
            <p class="muted small">En PC: Servidores → Añadir servidor, dirección <code>@_connection.Host</code> y puerto <code>@_connection.Port</code>.</p>
            <p class="muted small">
                En la Xbox: Servidores → <strong>Lifeboat</strong> → Unirse. Sale el menú de BedrockConnect: elige
                «@_connection.Name» o, la primera vez, «Connect to a Server» con esa dirección y ese puerto.
            </p>
        </div>
    }
</div>

@code {
    private string? _error;
    private bool _noUsers;

    [SupplyParameterFromForm]
    private LoginInput? Input { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private CubeKeeper.Web.Hosting.ServerConnection? _connection;

    protected override async Task OnInitializedAsync()
    {
        // El modelo del formulario va antes de cualquier await: Blazor pinta en el primer await.
        Input ??= new LoginInput();
        _connection = await Connection.GetAsync(new Uri(Navigation.BaseUri).Host);
        _noUsers = !UserManager.Users.Any();
        await Task.CompletedTask;
    }

    private async Task LoginAsync()
    {
        var result = await SignInManager.PasswordSignInAsync(Input!.UserName, Input.Password, Input.RememberMe, lockoutOnFailure: true);
        var ip = HttpContext?.Connection.RemoteIpAddress?.ToString();
        if (!result.RequiresTwoFactor)
        {
            await Audit.RecordAsync(Input.UserName, result.Succeeded ? "login.success" : result.IsLockedOut ? "login.locked" : "login.failed", ip);
        }
        if (result.RequiresTwoFactor)
        {
            var query = $"?RememberMe={Input.RememberMe}" + (string.IsNullOrEmpty(ReturnUrl) ? "" : $"&ReturnUrl={Uri.EscapeDataString(ReturnUrl)}");
            Navigation.NavigateTo("/login/2fa" + query, forceLoad: true);
            return;
        }
        if (result.Succeeded)
        {
            var target = !string.IsNullOrEmpty(ReturnUrl) && Uri.IsWellFormedUriString(ReturnUrl, UriKind.Relative) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//")
                ? ReturnUrl
                : "/";
            Navigation.NavigateTo(target, forceLoad: true);
            return;
        }

        _error = result.IsLockedOut
            ? "Demasiados intentos fallidos. Espera 15 minutos."
            : "Usuario o contraseña incorrectos.";
    }

    private sealed class LoginInput
    {
        [Required(ErrorMessage = "Indica el usuario.")]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Indica la contraseña.")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; } = true;
    }
}
