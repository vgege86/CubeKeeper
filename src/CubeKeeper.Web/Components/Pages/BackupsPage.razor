@page "/copias"
@attribute [Authorize(Roles = PanelRoles.Admin)]
@rendermode InteractiveServer
@inherits AuditedPage
@implements IDisposable
@using CubeKeeper.Core.Backups
@using CubeKeeper.Infrastructure.Backups
@using CubeKeeper.Infrastructure.Configuration
@using CubeKeeper.Infrastructure.Scheduling
@using CubeKeeper.Web.Formatting
@using Microsoft.Extensions.Options
@inject BackupService Backups
@inject CubeKeeper.Infrastructure.Storage.StorageService Storage
@inject BackupVerifier Verifier
@inject MaintenanceScheduler Scheduler
@inject IServerController Server
@inject IOptions<CubeKeeperOptions> Options
@inject DataPaths Paths
@inject TimeProvider Time
@inject ILogger<BackupsPage> Logger

<PageTitle>Copias · CubeKeeper</PageTitle>

<div class="page-head">
    <h1>Copias del mundo</h1>
    <div class="actions">
        <button class="btn btn-primary" disabled="@(_busy || Backups.IsBusy)" @onclick="CreateAsync">Hacer copia ahora</button>
    </div>
</div>

@if (_message is not null)
{
    <p class="alert @(_messageIsError ? "alert-error" : "alert-ok")" role="status">@_message</p>
}

<section class="card">
    <h2>Programación</h2>
    <dl class="facts">
        <dt>Copias automáticas</dt>
        <dd>
            @if (Scheduler.BackupsEnabled)
            {
                <span>Cada @Opt.IntervalMinutes min@(Opt.SkipIfIdle ? ", solo si alguien ha jugado desde la anterior" : "")</span>
                @if (Scheduler.NextBackupAt is { } next)
                {
                    <span class="muted"> · próxima: @(next <= Time.GetUtcNow() ? "en cuanto haya actividad" : Format.When(next, Time))</span>
                }
            }
            else
            {
                <span>Desactivadas</span>
            }
        </dd>
        <dt>Se guardan</dt>
        <dd>@Opt.KeepHourly horarias, @Opt.KeepDaily diarias y @Opt.KeepWeekly semanales; @Opt.KeepManual manuales; @Opt.KeepSafety de seguridad</dd>
        <dt>Mundo</dt>
        <dd><code>@_world</code></dd>
        <dt>Destinos</dt>
        <dd>
            <code>@Paths.Backups</code>
            @if (Backups.SecondaryPath is { } sec)
            {
                <span> y <code>@sec</code> </span>
                @if (Backups.SecondaryAvailable)
                {
                    <span class="ok">(montado)</span>
                }
                else
                {
                    <span class="hint-warn">(no existe: revisa el volumen en la app de TrueNAS)</span>
                }
            }
            else
            {
                <span class="muted"> · sin segundo destino (<code>CUBEKEEPER_BACKUP_SECONDARY</code>)</span>
            }
        </dd>
        <dt>Comprobación</dt>
        <dd>
            @if (Verifier.LastCheck is { } check)
            {
                <span class="@(check.Ok ? null : "hint-warn")">@Format.When(check.At, Time): <code>@check.File</code> · @check.Message</span>
            }
            else
            {
                <span class="muted">Todavía ninguna.</span>
            }
            <span class="muted"> Cada semana se abre una copia al azar para ver que se puede restaurar.</span>
            <button class="btn btn-ghost" disabled="@(_busy || Verifier.IsBusy || _entries.Count == 0)" @onclick="VerifyAsync">Comprobar una ahora</button>
        </dd>
    </dl>
    <p class="muted small">
        Con el servidor en marcha la copia es consistente (<code>save hold</code> → <code>save query</code> → copiar → <code>save resume</code>):
        no hace falta pararlo. Los archivos .mcworld se pueden abrir directamente en Minecraft.
    </p>
</section>

<section class="card">
    <h2>Copias <span class="count">@_entries.Count</span></h2>
    @if (_entries.Count == 0)
    {
        <p class="muted">Todavía no hay copias.</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>Fecha</th><th>Tipo</th><th>Tamaño</th><th>Dónde</th><th></th></tr></thead>
            <tbody>
                @foreach (var e in _entries)
                {
                    var b = e.File;
                    <tr>
                        <td>@Format.When(b.CreatedAt, Time)</td>
                        <td>@KindText(b.Kind)@if (b.World != _world) {<span class="muted"> · @b.World</span>}</td>
                        <td>@Size(b.Size)</td>
                        <td class="small">@(e.InSecondary ? "principal + 2.º destino" : "principal")</td>
                        <td class="row-actions">
                            @if (_confirm == b.FileName && _confirmAction == "restore")
                            {
                                <span class="hint-warn small">Se copiará antes el mundo actual@(Server.Snapshot.Status.IsProcessAlive() ? " y se reiniciará el servidor" : ""). </span>
                                <button class="btn btn-primary" disabled="@_busy" @onclick="() => RestoreAsync(b.FileName)">Restaurar</button>
                                <button class="btn btn-ghost" @onclick="Cancel">Cancelar</button>
                            }
                            else if (_confirm == b.FileName && _confirmAction == "delete")
                            {
                                <button class="btn btn-primary" disabled="@_busy" @onclick="() => Delete(b.FileName)">Borrar</button>
                                <button class="btn btn-ghost" @onclick="Cancel">Cancelar</button>
                            }
                            else
                            {
                                <a class="btn btn-ghost" href="@($"/copias/descargar/{Uri.EscapeDataString(b.FileName)}")" download>Descargar</a>
                                <button class="btn btn-ghost" disabled="@_busy" @onclick='() => Ask(b.FileName, "restore")'>Restaurar…</button>
                                <button class="btn btn-ghost" disabled="@_busy" @onclick='() => Ask(b.FileName, "delete")'>Borrar…</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="card">
    <div class="card-head">
        <h2>Espacio en disco</h2>
        <button class="btn btn-ghost" disabled="@_busy" @onclick="RefreshStorage">Volver a medir</button>
    </div>
    @foreach (var d in _storage.Disks)
    {
        <div class="disk @(d.Low ? "disk-low" : null)">
            <div class="disk-line">
                <strong>@d.Label</strong>
                <span>@Format.Size(d.Free) libres de @Format.Size(d.Total) (@d.FreePercent.ToString("0")%)</span>
            </div>
            <div class="bar" role="img" aria-label="@($"{100 - d.FreePercent:0}% ocupado")"><span style="width:@((100 - d.FreePercent).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></div>
            @if (d.Low)
            {
                <p class="hint-warn small">Queda poco espacio. Borra copias antiguas o amplía el dataset: si se llena, las copias y el propio mundo pueden fallar.</p>
            }
        </div>
    }
    @if (_storage.Folders.Count > 0)
    {
        <dl class="facts small">
            @foreach (var f in _storage.Folders)
            {
                <dt>@f.Label</dt>
                <dd>@Format.Size(f.Bytes)</dd>
            }
        </dl>
    }
    <p class="muted small">
        Avisa al móvil cuando queda menos del @Storage.Thresholds.WarnPercent.ToString("0.#")% o de @Storage.Thresholds.WarnGigabytes.ToString("0.#") GB libres
        (<code>CUBEKEEPER_DISK_WARN_PERCENT</code> y <code>CUBEKEEPER_DISK_WARN_GB</code>). Medido @Format.When(_storage.At, Time).
    </p>
</section>

@code {
    private IReadOnlyList<BackupEntry> _entries = [];
    private string _world = BackupService.DefaultLevelName;
    private string? _message;
    private bool _messageIsError;
    private bool _busy;
    private string? _confirm;
    private string? _confirmAction;

    private BackupOptions Opt => Options.Value.Backups;

    private CubeKeeper.Infrastructure.Storage.StorageReport _storage = new(DateTimeOffset.MinValue, [], []);

    protected override async Task OnInitializedAsync()
    {
        Backups.Changed += OnChanged;
        await LoadAsync();
        // El espacio libre es inmediato; recorrer las carpetas (el mapa puede tener miles de archivos) va aparte.
        _storage = new(Time.GetUtcNow(), Storage.MeasureDisks(), []);
        _ = LoadStorageAsync(refresh: false);
    }

    private async Task LoadStorageAsync(bool refresh)
    {
        var report = await Task.Run(() => Storage.GetReport(refresh));
        await InvokeAsync(() =>
        {
            _storage = report;
            StateHasChanged();
        });
    }

    private void RefreshStorage() => _ = LoadStorageAsync(refresh: true);

    private async Task VerifyAsync()
    {
        _busy = true;
        _message = null;
        StateHasChanged();
        try
        {
            var result = await Verifier.VerifyAsync();
            if (result is not null)
            {
                _message = result.Ok ? $"Copia comprobada: {result.File}. {result.Message}" : $"La copia {result.File} está dañada: {result.Message}";
                _messageIsError = !result.Ok;
                await AuditAsync("backup.verify", result.File, result.Message);
            }
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException)
        {
            Logger.LogWarning(ex, "No se pudo comprobar la copia");
            _message = ex.Message;
            _messageIsError = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadAsync()
    {
        _world = await Backups.GetWorldNameAsync();
        _entries = Backups.List();
    }

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private void Ask(string file, string action)
    {
        _confirm = file;
        _confirmAction = action;
    }

    private void Cancel()
    {
        _confirm = null;
        _confirmAction = null;
    }

    private Task CreateAsync() => RunAsync(async () =>
    {
        var b = await Backups.CreateAsync(BackupKind.Manual);
        _message = $"Copia creada ({Size(b.Size)}).";
        await AuditAsync("backup.create", b.FileName);
    });

    private Task RestoreAsync(string file) => RunAsync(async () =>
    {
        await Backups.RestoreAsync(file);
        _message = "Mundo restaurado.";
        await AuditAsync("backup.restore", file);
    });

    private Task Delete(string file) => RunAsync(() =>
    {
        Backups.Delete(file);
        _message = "Copia borrada.";
        return AuditAsync("backup.delete", file);
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _message = null;
        try
        {
            await action();
            _messageIsError = false;
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException or TimeoutException or InvalidDataException or UnauthorizedAccessException or ArgumentException)
        {
            Logger.LogWarning(ex, "Acción sobre copias fallida");
            _message = ex.Message;
            _messageIsError = true;
        }
        finally
        {
            _busy = false;
            Cancel();
            await LoadAsync();
        }
    }

    private static string KindText(BackupKind k) => k switch
    {
        BackupKind.Scheduled => "Programada",
        BackupKind.Manual => "Manual",
        BackupKind.PreUpdate => "Antes de actualizar",
        BackupKind.PreRestore => "Antes de restaurar",
        BackupKind.PreChange => "Antes de un cambio de mundo",
        _ => k.ToString(),
    };

    private static string Size(long bytes) => Format.Size(bytes);

    public void Dispose() => Backups.Changed -= OnChanged;
}
