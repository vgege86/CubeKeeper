@page "/"
@rendermode InteractiveServer
@inherits AuditedPage
@implements IDisposable
@using CubeKeeper.Core.Properties
@using CubeKeeper.Core.Versions
@using CubeKeeper.Infrastructure.Configuration
@using CubeKeeper.Infrastructure.State
@using CubeKeeper.Infrastructure.Settings
@using CubeKeeper.Infrastructure.Updates
@using CubeKeeper.Infrastructure.Scheduling
@using CubeKeeper.Web.Formatting
@using Microsoft.Extensions.Options
@inject IServerController Server
@inject IPlayerPresence Presence
@inject IVersionSource Versions
@inject IOptions<CubeKeeperOptions> Options
@inject DataPaths Paths
@inject ConfigurationAdvisor Advisor
@inject UpdateService Updates
@inject CubeKeeper.Infrastructure.Versions.VersionPin Pin
@inject MaintenanceScheduler Scheduler
@inject TimeProvider Time
@inject CubeKeeper.Web.Hosting.ConnectionInfoService Connection
@inject NavigationManager Navigation
@inject ILogger<Home> Logger
@inject CubeKeeper.Infrastructure.Security.KeyEncryptionSecret KeySecret
@inject CubeKeeper.Infrastructure.Storage.StorageService Storage
@inject RestartScheduler Restarts
@inject CubeKeeper.Infrastructure.Resources.ResourceMonitor Resources

<PageTitle>Panel · CubeKeeper</PageTitle>

<h1>Servidor</h1>

@if (_message is not null)
{
    <p class="alert @(_messageIsError ? "alert-error" : "alert-ok")" role="status">@_message</p>
}

@if (_isAdmin && _lowDisks.Count > 0)
{
    <p class="alert alert-warn" role="status">
        Queda poco espacio: @string.Join(" · ", _lowDisks.Select(d => $"{d.Label}, {Format.Size(d.Free)} libres")).
        <a href="/copias">Ver en Copias</a>
    </p>
}
@if (!KeySecret.IsSet)
{
    <AuthorizeView Roles="@PanelRoles.Admin">
        <p class="alert alert-warn" role="status">
            Las claves del panel (sesiones, token de ntfy y cuenta de Realms) se guardan sin cifrar en /data/keys. Añade la
            variable <code>CUBEKEEPER_KEY_SECRET</code> con una frase larga al azar (guárdala aparte) y reinicia la app.
        </p>
    </AuthorizeView>
}

<div class="grid">
    <section class="card">
        <h2>Estado</h2>
        <div class="status-row">
            <span class="badge badge-@BadgeClass(_snap.Status)">@_snap.Status.ToSpanish()</span>
            @if (_snap.StartedAt is DateTimeOffset since && _snap.Status == ServerStatus.Running)
            {
                <span class="muted">desde @since.ToLocalTime().ToString("dd/MM HH:mm")</span>
            }
        </div>
        <dl class="facts">
            <dt>Versión instalada</dt>
            <dd>@(_snap.InstalledVersion ?? "—")</dd>
            <dt>Versión en marcha</dt>
            <dd>@(_snap.RunningVersion ?? "—")</dd>
            <dt>Jugadores</dt>
            <dd><a href="/jugadores">@Presence.Online.Count conectado@(Presence.Online.Count == 1 ? "" : "s")</a>@if (Presence.Online.Count > 0) {<span class="muted"> · @string.Join(", ", Presence.Online.Select(p => p.Name))</span>}</dd>
            <dt>PID</dt>
            <dd>@(_snap.ProcessId?.ToString() ?? "—")</dd>
        </dl>
        @if (!string.IsNullOrEmpty(_snap.LastError) && _snap.Status is ServerStatus.Crashed or ServerStatus.Failed)
        {
            <p class="alert alert-error">@_snap.LastError</p>
        }
        <div class="actions">
            <button class="btn btn-primary" disabled="@(_busy || !CanStart)" @onclick="StartAsync">Arrancar</button>
            <button class="btn" disabled="@(_busy || !IsAlive)" @onclick="StopAsync">Parar</button>
            <button class="btn" disabled="@(_busy || !IsAlive)" @onclick="RestartAsync">Reiniciar</button>
        </div>
    </section>

    <section class="card">
        <h2>Versión de BDS</h2>
        @if (IsPinned)
        {
            <p class="muted">
                Versión fijada: <strong>@Pin.Version</strong> (sin actualizaciones automáticas)
                <span class="small">· @(Pin.FromPanel ? "fijada desde el panel" : "de CUBEKEEPER_BDS_VERSION")</span>
            </p>
            @if (Pin.FromPanel && Pin.EnvironmentVersion is { } envVersion && _isAdmin)
            {
                <p class="muted small">
                    La variable <code>CUBEKEEPER_BDS_VERSION</code> dice @envVersion, pero manda la fijada desde el panel.
                    <button class="btn btn-ghost" disabled="@_busy" @onclick="UseEnvironmentVersionAsync">Usar la de la variable</button>
                </p>
            }
        }
        else
        {
            <p class="muted">Canal: @(Options.Value.Bds.Channel == ReleaseChannel.Preview ? "preview" : "estable")</p>
        }
        @if (!Options.Value.Bds.AcceptEula)
        {
            <p class="alert alert-warn">
                Para descargar el servidor hay que aceptar la
                <a href="https://www.minecraft.net/eula" target="_blank" rel="noopener">EULA</a> y la
                <a href="https://go.microsoft.com/fwlink/?LinkId=521839" target="_blank" rel="noopener">política de privacidad</a>:
                pon <code>CUBEKEEPER_ACCEPT_EULA=true</code> en la app.
            </p>
        }
        @if (_latest is not null)
        {
            <p>@(IsPinned ? "A instalar" : "Última publicada"): <strong>@_latest.Version</strong> <span class="muted">(@_latest.Source)</span></p>
            @if (_snap.InstalledVersion is null)
            {
                <p>No hay ningún servidor instalado.</p>
            }
            else if (IsNewer)
            {
                <p>@(IsPinned ? "La versión instalada no es la fijada." : "Hay una versión nueva.")
                   Si el servidor está en marcha se parará, se instalará y se volverá a arrancar.</p>
            }
            else
            {
                <p class="ok">Está al día.</p>
            }
        }
        @if (NewerPublished is { } newer)
        {
            <p class="alert alert-warn">
                Mojang ha publicado la <strong>@newer.Version</strong> (tienes la @_snap.InstalledVersion).
                @if (_isAdmin)
                {
                    <span>Al instalarla queda fijada; antes se hace una copia del mundo y, si no arranca, se vuelve sola a la actual.</span>
                }
            </p>
        }
        <div class="actions">
            <button class="btn" disabled="@_busy" @onclick="CheckAsync">Comprobar</button>
            <AuthorizeView Roles="@PanelRoles.Admin" Context="adminContext">
                @if (_latest is not null && (_snap.InstalledVersion is null || IsNewer))
                {
                    <button class="btn btn-primary" disabled="@(_busy || !Options.Value.Bds.AcceptEula)" @onclick="InstallAsync">
                        @(_snap.InstalledVersion is null || IsPinned ? $"Instalar {_latest.Version}" : $"Actualizar a {_latest.Version}")
                    </button>
                }
                @if (NewerPublished is { } newerRelease)
                {
                    <button class="btn btn-primary" disabled="@(_busy || !Options.Value.Bds.AcceptEula)" @onclick="InstallNewestAsync">Instalar @newerRelease.Version</button>
                }
            </AuthorizeView>
        </div>
        @if (_progress is not null)
        {
            <p class="muted small">@_progress</p>
        }
        <dl class="facts small">
            <dt>Automática</dt>
            <dd>
                @if (Updates.IsPinned)
                {
                    <span>No (versión fijada)</span>
                }
                else if (!Updates.AutoUpdateActive)
                {
                    <span>Desactivada</span>
                }
                else
                {
                    <span>Cada día a las @Options.Value.Updates.Time@(Scheduler.NextUpdateCheckAt is { } n ? $" · próxima: {Format.When(n, Time)}" : "")</span>
                }
            </dd>
            @if (Updates.LastUpdate is { } last)
            {
                <dt>Última</dt>
                <dd class="@(last.Succeeded ? null : "hint-warn")">@Format.When(last.At, Time): @last.Message</dd>
            }
        </dl>
        @if (Updates.PreviousVersion is { } prev && _snap.InstalledVersion is not null && _isAdmin)
        {
            @if (_confirmRollback)
            {
                <p class="hint-warn small">Se hará una copia del mundo y se instalará la @prev. Un mundo abierto con una versión más nueva podría no cargar en una anterior.</p>
                <div class="actions">
                    <button class="btn btn-primary" disabled="@_busy" @onclick="RollbackAsync">Volver a @prev</button>
                    <button class="btn btn-ghost" @onclick="() => _confirmRollback = false">Cancelar</button>
                </div>
            }
            else
            {
                <div class="actions"><button class="btn btn-ghost" disabled="@_busy" @onclick="() => _confirmRollback = true">Volver a la versión anterior (@prev)…</button></div>
            }
        }
    </section>

    <section class="card">
        <div class="card-head">
            <h2>Recursos</h2>
            <div class="segmented" role="group" aria-label="Periodo">
                @foreach (var (hours, text) in new[] { (1, "1 h"), (6, "6 h"), (24, "24 h") })
                {
                    <button class="@(_resourceHours == hours ? "on" : null)" aria-pressed="@(_resourceHours == hours)" @onclick="() => _resourceHours = hours">@text</button>
                }
            </div>
        </div>
        @if (!Resources.Supported)
        {
            <p class="muted">Solo se mide en Linux (en el NAS).</p>
        }
        else
        {
            var now = Time.GetUtcNow();
            var from = now.AddHours(-_resourceHours);
            var history = Resources.History(TimeSpan.FromHours(_resourceHours));
            var latest = Resources.Latest;
            <h3 class="sub">Memoria</h3>
            <p class="small">
                @if (latest?.ServerMemory is long sm) {<span>Servidor <strong>@Format.Size(sm)</strong></span>}
                @if (latest?.ContainerMemory is long cm)
                {
                    <span> · contenedor @Format.Size(cm)@(latest.ContainerLimit is long cl ? $" de {Format.Size(cl)} ({latest.ContainerMemoryPercent:0}%)" : "")</span>
                }
                @if (latest is null) {<span class="muted">Midiendo…</span>}
            </p>
            <LineChart Label="Memoria del contenedor en las últimas horas"
                       Points="@history.Select(s => (s.At, s.ContainerMemory is long m ? (double?)m : null)).ToList()"
                       From="from" To="now" Format="@(v => Format.Size((long)v))"
                       Reference="@(latest?.ContainerLimit is long lim ? lim : null)"
                       ReferenceLabel="@(latest?.ContainerLimit is long lim2 ? $"límite {Format.Size(lim2)}" : null)" />
            <h3 class="sub">CPU del servidor</h3>
            <p class="small">
                @if (latest?.ServerCpuPercent is double cpu) {<span><strong>@cpu.ToString("0.#")%</strong> de @Resources.Cpus.ToString("0.#") CPU</span>}
                else {<span class="muted">@(_snap.ProcessId is null ? "El servidor no está en marcha." : "Midiendo…")</span>}
            </p>
            <LineChart Label="CPU del servidor en las últimas horas"
                       Points="@history.Select(s => (s.At, s.ServerCpuPercent)).ToList()"
                       From="from" To="now" Format="@(v => v.ToString("0.#") + " %")"
                       Max="@CpuMax(history)" />
            <p class="muted small">Se mide cada 30 s y se guardan las últimas 24 h (se pierden al reiniciar la app). Avisa al móvil si la memoria se acerca al límite.</p>
        }
    </section>

    <section class="card">
        <h2>Reinicio programado</h2>
        <p class="muted small">
            Reiniciar el servidor cada día libera la memoria que BDS va acumulando. Avisa antes por el chat.
        </p>
        @if (_isAdmin)
        {
            <label class="check"><input type="checkbox" @bind="_restartEnabled" /> Reiniciar cada día</label>
            <div class="form-row">
                <label>Hora <input type="time" @bind="_restartTime" disabled="@(!_restartEnabled)" /></label>
                <label>Avisos (minutos antes) <input @bind="_restartWarnings" disabled="@(!_restartEnabled)" placeholder="30,15,5,1" inputmode="numeric" /></label>
            </div>
            <label class="check"><input type="checkbox" @bind="_restartSkip" disabled="@(!_restartEnabled)" /> Esperar a que no quede nadie jugando</label>
            <p class="muted small">
                @(_restartSkip
                    ? "Si a la hora hay alguien dentro, no se reinicia hasta que salgan todos (lo recuerda por el chat cada 10 minutos)."
                    : "Se reinicia a la hora aunque haya alguien jugando (después de los avisos).")
            </p>
            <div class="actions">
                <button class="btn" disabled="@_busy" @onclick="SaveRestartAsync">Guardar</button>
            </div>
        }
        <dl class="facts small">
            <dt>Próximo</dt>
            <dd>@(Restarts.Settings.Enabled ? (Restarts.NextRunAt is { } nr ? Format.When(nr, Time) : $"cada día a las {Restarts.Settings.Time}") : "desactivado")</dd>
            @if (Restarts.WaitingSince is { } ws)
            {
                <dt>Pendiente</dt>
                <dd class="hint-warn">Esperando a que no quede nadie (desde @Format.When(ws, Time))</dd>
            }
            @if (Restarts.LastRun is { } lr)
            {
                <dt>Último</dt>
                <dd class="@(lr.Restarted ? null : "hint-warn")">@Format.When(lr.At, Time): @lr.Message</dd>
            }
        </dl>
    </section>

    <section class="card">
        <h2>Cómo conectarse</h2>
        <p class="connect">Dirección <code>@_connection?.Host</code> · puerto <code>@_connection?.Port</code></p>
        <p class="muted small">
            En PC (ROG Ally): Servidores → Añadir servidor, con esa dirección y ese puerto.
        </p>
        <p>
            En la Xbox no se pueden añadir servidores por IP y unirse desde «Partidas LAN» falla. Con MCXboxBroadcast:
            agrega como amigo su cuenta y entra desde <strong>Jugar → Amigos</strong>. Con BedrockConnect (reglas de
            AdGuard): Servidores → un destacado → Unirse → «Connect to a Server» con esa dirección y ese puerto. La Xbox
            tiene que tener la misma versión del juego que el servidor.
        </p>
    </section>

    @if (_deviations.Count > 0 && _isAdmin)
    {
        <section class="card wide">
            <h2>Configuración recomendada</h2>
            <p>Estos ajustes de <code>server.properties</code> no coinciden con la configuración probada en el NAS:</p>
            <table class="table">
                <thead><tr><th>Ajuste</th><th>Ahora</th><th>Recomendado</th><th>Por qué</th></tr></thead>
                <tbody>
                    @foreach (var d in _deviations)
                    {
                        <tr>
                            <td><code>@d.Setting.Key</code></td>
                            <td><code>@(d.CurrentValue is null ? "(falta)" : d.CurrentValue.Length == 0 ? "(vacío)" : d.CurrentValue)</code></td>
                            <td><code>@(d.Setting.Value.Length == 0 ? "(vacío)" : d.Setting.Value)</code></td>
                            <td class="small">@d.Setting.Reason</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="actions">
                <button class="btn btn-primary" disabled="@_busy" @onclick="ApplyRecommendedAsync">Aplicar recomendados</button>
                <span class="muted small">Se guarda una copia del archivo actual. Hay que reiniciar el servidor para que surta efecto.</span>
            </div>
        </section>
    }
</div>

@code {
    private ServerSnapshot _snap = default!;
    private BdsRelease? _latest;
    private bool _busy;
    private string? _message;
    private bool _messageIsError;
    private string? _progress;
    private bool _isAdmin;
    private IReadOnlyList<CubeKeeper.Core.Properties.SettingDeviation> _deviations = [];

    private bool IsPinned => Pin.IsPinned;

    private BdsRelease? _newest;

    private IReadOnlyList<CubeKeeper.Infrastructure.Storage.DiskUsage> _lowDisks = [];

    private int _resourceHours = 6;

    private static double CpuMax(IReadOnlyList<CubeKeeper.Infrastructure.Resources.ResourceSample> history)
    {
        var top = history.Select(s => s.ServerCpuPercent ?? 0).DefaultIfEmpty(0).Max();
        return top <= 10 ? 10 : top <= 25 ? 25 : top <= 50 ? 50 : 100;
    }

    private void OnResourcesSampled() => _ = InvokeAsync(StateHasChanged);

    private bool _restartEnabled;
    private TimeOnly _restartTime = new(5, 30);
    private string _restartWarnings = "30,15,5,1";
    private bool _restartSkip = true;

    private void LoadRestartSettings()
    {
        var r = Restarts.Settings;
        _restartEnabled = r.Enabled;
        _restartTime = CubeKeeper.Core.Scheduling.DailySchedule.ParseTime(r.Time) ?? new TimeOnly(5, 30);
        _restartWarnings = r.WarningMinutes;
        _restartSkip = r.WaitForEmpty;
    }

    private Task SaveRestartAsync() => RunAsync(async () =>
    {
        if (!await IsAdminAsync())
        {
            throw new InvalidOperationException("Solo un administrador puede cambiar el reinicio programado.");
        }
        if (Restarts.SaveSettings(_restartEnabled, _restartTime.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture), _restartWarnings, _restartSkip) is { } error)
        {
            throw new InvalidOperationException(error);
        }
        LoadRestartSettings();
        await AuditAsync("server.restart.schedule", null,
            _restartEnabled ? $"cada día a las {_restartTime:HH\\:mm}, avisos {_restartWarnings}{(_restartSkip ? ", esperando a que no quede nadie" : "")}" : "desactivado");
        _message = _restartEnabled ? $"Reinicio programado cada día a las {_restartTime:HH\\:mm}." : "Reinicio programado desactivado.";
    }, null);

    /// <summary>Con versión fijada: la última publicada, si es más nueva que la instalada (y no es la que ya se ofrece).</summary>
    private BdsRelease? NewerPublished =>
        IsPinned && _newest is not null && _snap.InstalledVersion is not null &&
        BdsVersion.TryParse(_snap.InstalledVersion, out var installedVersion) && installedVersion is not null &&
        _newest.Version > installedVersion && !(IsNewer && _latest is not null && _latest.Version.Equals(_newest.Version))
            ? _newest
            : null;

    private bool IsAlive => _snap.Status.IsProcessAlive();
    private bool CanStart => !IsAlive && _snap.Status is not ServerStatus.NotInstalled and not ServerStatus.Installing;

    private bool IsNewer =>
        _latest is not null &&
        (!BdsVersion.TryParse(_snap.InstalledVersion, out var installed) || installed is null ||
         (IsPinned ? !_latest.Version.Equals(installed) : _latest.Version > installed));

    private CubeKeeper.Web.Hosting.ServerConnection? _connection;

    protected override async Task OnInitializedAsync()
    {
        _snap = Server.Snapshot;
        Server.StateChanged += OnStateChanged;
        Presence.Changed += OnPresenceChanged;
        Resources.Sampled += OnResourcesSampled;
        await LoadPropertiesAsync();
        _isAdmin = await IsAdminAsync();
        LoadRestartSettings();
        if (_isAdmin)
        {
            _lowDisks = Storage.MeasureDisks().Where(d => d.Low).ToList();
        }
        // Comprueba las versiones sin bloquear la página (así el botón «Instalar» sale solo tras el aviso al móvil).
        _ = InvokeAsync(async () =>
        {
            try
            {
                await LoadVersionsAsync();
                StateHasChanged();
            }
            catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException)
            {
                Logger.LogDebug(ex, "No se pudieron comprobar las versiones al abrir el panel");
            }
        });
    }

    private async Task LoadVersionsAsync()
    {
        _latest = await Versions.GetLatestAsync(Options.Value.Bds.Channel);
        _newest = IsPinned ? await Versions.GetNewestPublishedAsync(Options.Value.Bds.Channel) : null;
    }

    private async Task LoadPropertiesAsync()
    {
        _connection = await Connection.GetAsync(new Uri(Navigation.BaseUri).Host);
        _deviations = await Advisor.CheckAsync();
    }

    private bool _confirmRollback;

    private Task RollbackAsync() => RunAsync(async () =>
    {
        if (!await IsAdminAsync())
        {
            throw new InvalidOperationException("Solo un administrador puede cambiar de versión.");
        }
        var result = await Updates.RollbackAsync();
        _confirmRollback = false;
        _message = result.Message;
        await AuditAsync("server.rollback", result.To, result.Message);
        if (!result.Succeeded)
        {
            throw new InvalidOperationException(result.Message);
        }
    }, null);

    private Task ApplyRecommendedAsync() => RunAsync(async () =>
    {
        if (!await IsAdminAsync())
        {
            throw new InvalidOperationException("Solo un administrador puede cambiar los ajustes.");
        }
        var changed = await Advisor.ApplyAsync();
        await LoadPropertiesAsync();
        await AuditAsync("settings.recommended", null, string.Join(", ", changed));
        _message = changed.Count == 0
            ? "No había nada que cambiar."
            : $"Cambiado: {string.Join(", ", changed)}. Reinicia el servidor para aplicarlo.";
    }, null);

    private void OnStateChanged(ServerSnapshot snap)
    {
        _snap = snap;
        _ = InvokeAsync(StateHasChanged);
    }

    private Task StartAsync() => RunAsync(() => Server.StartAsync(), "Servidor arrancado.", "server.start");

    private Task StopAsync() => RunAsync(() => Server.StopAsync(), "Servidor parado.", "server.stop");

    private Task RestartAsync() => RunAsync(() => Server.RestartAsync(), "Servidor reiniciado.", "server.restart");

    private Task CheckAsync() => RunAsync(async () =>
    {
        await LoadVersionsAsync();
        if (_latest is null)
        {
            throw new InvalidOperationException("No se pudo obtener la última versión. Revisa la consola del contenedor.");
        }
    }, null);

    private Task InstallAsync() => RunAsync(async () =>
    {
        if (!await IsAdminAsync())
        {
            throw new InvalidOperationException("Solo un administrador puede instalar o actualizar.");
        }
        var progress = new Progress<string>(m =>
        {
            _progress = m;
            _ = InvokeAsync(StateHasChanged);
        });
        UpdateRecord result;
        // Instalación nueva: directa. Actualización: copia del mundo, instalación, comprobación y vuelta atrás si falla.
        if (_snap.InstalledVersion is null)
        {
            var installed = await Server.InstallAsync(_latest!, progress);
            result = new UpdateRecord(Time.GetUtcNow(), null, installed.Version, true, $"Instalado {installed.Version}.");
        }
        else
        {
            result = await Updates.UpdateAsync(_latest!, []);
        }
        _progress = null;
        _message = result.Message;
        _messageIsError = !result.Succeeded;
        await LoadPropertiesAsync();
        await AuditAsync("server.install", _latest!.Version.Text, result.Message);
    }, null);

    /// <summary>Instala la última publicada aunque haya una versión fijada; si va bien, queda fijada.</summary>
    private Task InstallNewestAsync() => RunAsync(async () =>
    {
        if (!await IsAdminAsync())
        {
            throw new InvalidOperationException("Solo un administrador puede instalar o actualizar.");
        }
        var release = NewerPublished ?? throw new InvalidOperationException("No hay una versión más nueva que instalar.");
        var result = await Updates.UpdateAsync(release, []);
        _message = result.Message;
        _messageIsError = !result.Succeeded;
        await LoadVersionsAsync();
        await LoadPropertiesAsync();
        await AuditAsync("server.install", release.Version.Text, result.Message);
    }, null);

    private Task UseEnvironmentVersionAsync() => RunAsync(async () =>
    {
        if (!await IsAdminAsync())
        {
            throw new InvalidOperationException("Solo un administrador puede cambiar la versión fijada.");
        }
        Pin.UseEnvironment();
        await LoadVersionsAsync();
        await AuditAsync("server.pin", Pin.Version, "Vuelve a mandar CUBEKEEPER_BDS_VERSION");
        _message = $"Ahora manda CUBEKEEPER_BDS_VERSION ({Pin.Version}).";
    }, null);

    private async Task RunAsync(Func<Task> action, string? okMessage, string? auditAction = null)
    {
        _busy = true;
        _message = null;
        try
        {
            await action();
            if (okMessage is not null)
            {
                _message = okMessage;
            }
            _messageIsError = false;
            if (auditAction is not null)
            {
                await AuditAsync(auditAction);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Acción del panel fallida");
            _message = ex.Message;
            _messageIsError = true;
        }
        finally
        {
            _busy = false;
            _snap = Server.Snapshot;
        }
    }

    private static string BadgeClass(ServerStatus s) => s switch
    {
        ServerStatus.Running => "ok",
        ServerStatus.Starting or ServerStatus.Stopping or ServerStatus.Installing => "busy",
        ServerStatus.Crashed or ServerStatus.Failed => "error",
        _ => "idle",
    };

    private void OnPresenceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Server.StateChanged -= OnStateChanged;
        Presence.Changed -= OnPresenceChanged;
        Resources.Sampled -= OnResourcesSampled;
    }
}
